[Desktop Entry]
Type=Application
Name=Lens
GenericName=Screen assistant
Comment=Select part of the screen and ask Claude Code about it
Comment[ru]=Выделите часть экрана и спросите о ней Claude Code
Exec=lens
Icon=io.github.lensdesktop.Lens
Terminal=false
Categories=Utility;
Keywords=claude;ai;screenshot;ocr;translate;
StartupWMClass=lens
Actions=select;history;settings;

[Desktop Action select]
Name=Select an area and ask
Name[ru]=Выделить область и спросить
Exec=lens --select

[Desktop Action history]
Name=Chat history
Name[ru]=История чатов
Exec=lens --history

[Desktop Action settings]
Name=Settings
Name[ru]=Настройки
Exec=lens --settings
